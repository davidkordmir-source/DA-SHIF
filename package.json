{
  "name": "hamshift",
  "private": true,
  "version": "2.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "release": "npm run build && python3 scripts/package.py",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run src/lib",
    "test:e2e": "playwright test",
    "desktop": "npm run build && node scripts/prepare-desktop.mjs && electron .",
    "desktop:pack": "npm run build && node scripts/prepare-desktop.mjs && electron-builder --config electron-builder.cjs --win dir --x64 --publish never",
    "desktop:build": "npm run desktop:pack && node scripts/build-installer.mjs",
    "test:desktop": "node --test electron/*.test.cjs"
  },
  "dependencies": {
    "@fontsource-variable/baloo-bhaijaan-2": "^5.3.0",
    "@fontsource-variable/estedad": "^5.3.0",
    "@fontsource-variable/markazi-text": "^5.3.0",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@fontsource-variable/readex-pro": "^5.3.0",
    "@fontsource-variable/vazirmatn": "^5.2.8",
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/lalezar": "^5.3.0",
    "exceljs": "^4.4.0",
    "jalaali-js": "^1.2.8",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/jalaali-js": "^1.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "resedit": "3.1.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.2.0"
  },
  "main": "electron/main.cjs",
  "description": "Offline Persian staff scheduler for Windows",
  "author": "Hamshift"
}
